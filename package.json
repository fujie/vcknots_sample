{
  "name": "vcknots-sample",
  "version": "1.0.0",
  "private": true,
  "description": "VCknots Verifiable Credentials Ecosystem - Monorepo",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n issuer,issuer-ui,verifier,verifier-ui,wallet,admin -c blue,cyan,green,yellow,magenta,white \"npm run dev:issuer\" \"npm run dev:issuer-ui\" \"npm run dev:verifier\" \"npm run dev:verifier-ui\" \"npm run dev:wallet\" \"npm run dev:admin\"",
    "dev:issuer": "npm run dev -w @vcknots-sample/issuer",
    "dev:issuer-ui": "npm run dev:client -w @vcknots-sample/issuer",
    "dev:verifier": "npm run dev -w @vcknots-sample/verifier",
    "dev:verifier-ui": "npm run dev:client -w @vcknots-sample/verifier",
    "dev:wallet": "npm run dev -w @vcknots-sample/wallet",
    "dev:admin": "npm run dev -w @vcknots-sample/admin",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "fast-check": "^4.1.1",
    "jsdom": "^29.1.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.7.0",
    "vitest": "^3.2.1"
  },
  "dependencies": {
    "@trustknots/vcknots": "^0.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
